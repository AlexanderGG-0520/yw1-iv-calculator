{
  "name": "ykw1-iv-reverse-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server && vite build --ssr server/reverseWorker.ts --outDir dist-worker",
    "build": "tsc -b && npm run build:web && npm run build:server",
